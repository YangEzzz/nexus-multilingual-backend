# Merge into the existing ignored .env; preserve existing database credentials.
PORT=3457
DB_NAME=nexus_db
AUTO_MIGRATE=false
FRONTEND_URL=https://nexus.team-tool.top
# Separate API domain: the callback path is generated automatically.
# Local development uses the FRONTEND_URL proxy; omit PUBLIC_API_URL there.
PUBLIC_API_URL=https://nexus-api.team-tool.top
ALLOWED_ORIGINS=https://nexus.team-tool.top
COOKIE_SECURE=true
# Browser authorization enters the Helios API subdomain, then redirects to its UI.
HELIOS_BASE_URL=https://helios-api.team-tool.top
HELIOS_INTERNAL_URL=http://127.0.0.1:3456
HELIOS_CLIENT_ID=nexus-multilingual-production
HELIOS_CLIENT_SECRET=replace-with-the-once-displayed-secret
# Optional override for an existing/custom registered callback:
# HELIOS_REDIRECT_URI=https://nexus-api.team-tool.top/api/v1/auth/sso/callback
HELIOS_PROJECT_ID=nexus-multilingual
HELIOS_ALLOWED_ROLES=admin,owner,productor,developer,translator
